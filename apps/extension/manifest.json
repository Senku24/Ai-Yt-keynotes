{
  "manifest_version": 3,
  "name": "KeyNotes — YouTube Takeaways",
  "version": "1.0.0",
  "description": "Paste a YouTube link and get five transcript-grounded key takeaways.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
